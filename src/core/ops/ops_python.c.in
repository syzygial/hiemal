  %%SOURCE_PYOP_METHODS%%
};

static PyModuleDef hm_ops_source_module_def = {
  .m_base = PyModuleDef_HEAD_INIT,
  .m_name = "hiemal._c.ops.source",
  .m_methods = hm_ops_source_module_methods
};

static int init_source_ops(PyObject *m) {
  PyObject *source_module = PyModule_Create(&hm_ops_source_module_def);
