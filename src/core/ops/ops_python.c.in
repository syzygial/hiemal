// ops

static PyModuleDef hm_ops_module_def = {
  .m_base = PyModuleDef_HEAD_INIT,
  .m_name = "hiemal._c.ops",
};

int init_ops(PyObject *m) {
  PyObject *ops_module = PyModule_Create(&hm_ops_module_def);
  init_source_ops(ops_module);
  init_sink_ops(ops_module);
  init_dsp_ops(ops_module);
  PyModule_AddObject(m, "ops", ops_module);
  return 0;
}